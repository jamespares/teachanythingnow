{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-minute-lessons",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://www.lastminutelessons.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teach-anything-db",
      "database_id": "8628e8d5-92a7-43f5-96d9-f430f2b2dd2c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "teach-anything-assets"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
