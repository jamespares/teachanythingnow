# Better Auth Configuration
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-char-secret-here
BETTER_AUTH_URL=http://localhost:8787

# No AI provider keys needed — all generation runs on Cloudflare Workers AI
# (Kimi K2.6 + Llama 3.3 70B for text, FLUX.1 schnell for images, Deepgram Aura-1 for audio)
# via the `ai` binding configured in wrangler.jsonc.
